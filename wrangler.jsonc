{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totaaltegel-maatwerk-checkout",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  // Shopify sees every Worker subrequest as 2a06:98c0:3600::103 (Cloudflare cross-zone),
  // so that address is the app's IP allowlist entry, wherever the Worker runs.
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "SHOPIFY_API_VERSION": "2026-10",
    // Comma-separated. 127.0.0.1:9292 is `shopify theme dev`.
    "ALLOWED_ORIGINS": "https://www.totaaltegel.nl,https://totaaltegel.nl,https://totaaltegel.myshopify.com,http://127.0.0.1:9292"
  },
  // Public config only. Secrets go through `wrangler secret put`:
  // SHOPIFY_SHOP, SHOPIFY_ADMIN_ACCESS_TOKEN (the latter via `npm run token`)
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
